"          {/* TAB ALCANCE OPERATIVO */}\n          {activeTab360 === 'alcance' && (\n            <div className=\"space-y-6 animate-in fade-in duration-200\">\n              {isEditing360 && wizardData ? (\n                // EDIT MODE\n                <div className=\"space-y-6\">\n                  <div className=\"bg-[var(--bg-color)] p-5 rounded-xl border border-[var(--border-color)] space-y-4\">\n                    <h4 className=\"font-extrabold text-[var(--text-primary)] text-[12.5px] border-b border-[var(--border-color)] pb-2 flex items-center gap-1.5\">\n                      <SlidersHorizontal size={14} className=\"text-rose-500\" /> Resumen del Alcance Operativo\n                    </h4>\n                    <div className=\"grid grid-cols-2 gap-y-3 gap-x-2 text-[12px] pt-1 items-center max-w-lg\">\n                      <span className=\"text-[var(--text-muted)] font-semibold\">Tipo de Alcance:</span>\n                      <select\n                        value={wizardData.scope_type || 'COMPANY'}\n                        onChange={(e) => {\n                          const val = e.target.value;\n                          handleChange('scope_type', val);\n                          if (val === 'COMPANY') {\n                            handleChange('scope_entity_ids', []);\n                            handleChange('include_children', true);\n                          }\n                        }}\n                        className=\"px-2 py-1 text-[11px] rounded border border-[var(--border-color)] bg-[var(--bg-elevated)] text-[var(--text-primary)] font-bold focus:outline-none focus:border-rose-500 w-full\"\n                      >\n                        <option value=\"COMPANY\">Toda la empresa</option>\n                        <option value=\"GROUPING\">Por agrupación</option>\n                        <option value=\"ROUTE\">Por ruta operativa</option>\n                        <option value=\"AGENCY\">Por agencia</option>\n                        <option value=\"TERRITORY\">Por territorio</option>
