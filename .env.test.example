# ============================================================================
# PLANTILLA DE AMBIENTE LOCAL DE PRUEBAS (POSTGRESQL 18)
# Archivo: .env.test.example
# Proyecto: Ride Lab — Bikers' Fort Core
# 
# INSTRUCCIONES:
# Copie este archivo a .env.test.local y configure la contraseña local del
# usuario bikers_test. .env.test.local está ignorado por Git por seguridad.
# ============================================================================

# Identificador de Entorno
APP_ENV=test
NODE_ENV=development

# Conexión Exclusiva a PostgreSQL Local (Puerto 5432 / bikers_dbtest)
# IMPORTANTE: Reemplace TU_PASSWORD_LOCAL con la contraseña de bikers_test
DATABASE_URL=postgresql://bikers_test:TU_PASSWORD_LOCAL@127.0.0.1:5432/bikers_dbtest?sslmode=disable
DB_SCHEMA=admin
DB_POOL_MAX=5

# Secretos de Sesión Locales de Prueba
JWT_SECRET=test_jwt_secret_bikers_fort_core_2026_local_isolated
SESSION_SECRET=test_session_secret_bikers_fort_core_2026_local_isolated

# Bloqueo Estricto de Integraciones Externas en Pruebas
DISABLE_EXTERNAL_SERVICES=true
ENABLE_SMS=false
ENABLE_EMAIL=false

# Mocks para AWS (Evita conexiones o escrituras a buckets o SES productivos)
AWS_REGION=us-east-1
AWS_S3_BUCKET=bikers-test-mock-media
AWS_ACCESS_KEY_ID=mock_test_aws_key_id
AWS_SECRET_ACCESS_KEY=mock_test_aws_secret_access_key
AWS_SES_SENDER=pruebas@ridelab.test
AWS_S3_PRESIGNED_URL_EXPIRES=300

# Mocks para TextBee SMS Gateway
TEXTBEE_API_URL=https://api.textbee.dev/api/v1/gateway/send-sms
TEXTBEE_API_KEY=mock_textbee_api_key_test
TEXTBEE_DEVICE_ID=mock_textbee_device_id_test
TEXTBEE_TIMEOUT_MS=5000
TEXTBEE_SYNC_SECRET=test_sync_secret_mock
CRON_SECRET=test_cron_secret_mock

# URL Base Local de la Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000
